          "id": "4fa37c1d-9461-4a09-846f-a840ecdef20b",
          "name": "Create an invoice audit",
          "request": {
            "name": "Create an invoice audit",
            "description": {
              "content": "Upload a carrier invoice and audit it against the rates and surcharges of an existing contract. Returns immediately with `status=PENDING`; auditing runs asynchronously. Poll `GET /v1/invoice-audits` until `status=COMPLETE` to retrieve findings.\n\nAccepted file formats: PDF, CSV.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "invoice-audits"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "description": "(Required) The carrier invoice document. Accepted MIME types: `application/pdf`, `text/csv`."
                },
                {
                  "key": "contract_id",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) ID of the contract to audit this invoice against."
                }
              ]
            }
