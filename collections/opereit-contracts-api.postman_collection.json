          "id": "71bfc61c-e31a-4e20-b36d-099055d99b72",
          "name": "Upload a carrier contract",
          "request": {
            "name": "Upload a carrier contract",
            "description": {
              "content": "Upload a carrier contract document. Opereit asynchronously extracts rate cards and surcharges from the file. The contract is created with `status=PROCESSING`; it transitions to `ACTIVE` once extraction completes (or `FAILED` if extraction errors out).\n\nAccepted file formats: PDF, PNG, JPEG, CSV, XLS, XLSX.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "contracts"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "description": "(Required) The contract document. Accepted MIME types: `application/pdf`, `image/png`, `image/jpeg`, `text/csv`, `application/vnd.ms-excel`, `application/vnd.openxmlformats-officedocument.spreadsheetml.sheet`."
                },
                {
                  "key": "carrier_name",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) The carrier this contract belongs to (e.g. `UPS`, `FedEx`, `DHL Express`)."
                },
                {
                  "key": "signing_date",
                  "value": "<date>",
                  "type": "text",
                  "description": "(Required) Date the contract was signed, in `YYYY-MM-DD` format."
                },
                {
                  "key": "contract_number",
                  "value": "<string>",
                  "type": "text",
                  "description": "Optional carrier-issued contract number."
                },
                {
                  "key": "account_number",
                  "value": "<string>",
                  "type": "text",
                  "description": "Optional carrier account number this contract applies to."
                }
              ]
            }
          },
